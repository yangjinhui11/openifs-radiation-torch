# ============================================================
# .gitignore for openifs-radiation-torch
# ============================================================

# ---- LaTeX manuscript (hosted separately / not in this repo) ----
AGU_JAMES_AGUTeX_Article/
**/*.aux
**/*.bbl
**/*.blg
**/*.log
**/*.out
**/*.fdb_latexmk
**/*.fls
**/*.synctex.gz
**/*.toc

# ---- Reference PDFs (copyrighted literature, not redistributed) ----
# Ignore all top-level PDFs EXCEPT paper figures
/*.pdf
# (paper_figure/*.pdf is allowed — figure outputs)

# ---- Vendored third-party libraries (re-downloadable) ----
presentation/mathjax/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Temporary / scratch ----
/tmp/
*.tmp
*.bak
*.orig

# ---- Large raw data NOT regenerated by scripts (ERA5 raw GRIB/NetCDF) ----
*.grib
*.grib2
*.grb
era5_*.nc
# (subsampled .npz/.json results used for figures ARE committed)
